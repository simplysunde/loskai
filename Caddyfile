# Bootstrap Caddyfile for the native Caddy LXC — reference config.
#
# It defines NO routes: only the admin endpoint, the TLS setup, and the certificate-
# onboarding page. Every route (loskai, adguard, grafana, …) is pushed at runtime by Loskai
# via the Admin API, each reusing the internal cert below. Caddy autosaves after every API
# change and runs with `caddy run --resume`, so routes survive restarts with no action from
# Loskai.
#
# Default TLS is Caddy's internal CA (local_certs) — no real domain or ACME/DNS token needed.
# Set BASE_DOMAIN in Caddy's environment on the Caddy LXC. LAN devices trust the internal root once
# via the onboarding page below (see docs/certificate-setup.md). For the public-ACME
# alternative, see the commented block at the bottom.

{
	# Firewall this: only the Docker host (e.g. 192.168.10.100) may reach :2019.
	admin 0.0.0.0:2019
	local_certs   # Caddy is its own CA — issues an internal cert per name on demand
}

# Issue an internal cert for each *.{$BASE_DOMAIN} name on demand. No handlers -> cert only
# (this is not a routing catch-all).
*.{$BASE_DOMAIN} {
	tls internal
}

# Certificate-onboarding page on :80 — plain HTTP so a LAN device can install the internal
# root *before* that root is trusted. Reach it by IP: http://<lxc-ip>/. The PKI path matches
# this service's data dir (XDG_DATA_HOME=/var/lib/caddy in create-caddy-lxc.sh's systemd unit).
:80 {
	handle /caddy-root.crt {
		root * /var/lib/caddy/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		root * /srv/setup
		file_server
	}
}

# --- Future: public ACME certs instead of the internal CA ---------------------------------
# Replace `local_certs` above + this whole `:80` block with a DNS-challenge wildcard. Requires
# a Caddy build with the matching caddy-dns plugin and the provider token in Caddy's env
# (create-caddy-lxc.sh does this when run with TLS_MODE=acme).
#
# *.{$BASE_DOMAIN} {
# 	tls {
# 		dns duckdns {env.DUCKDNS_TOKEN}   # swap provider + token to match your domain
# 	}
# }

# Caddyfile for public ACME certificates (DNS-01), the alternative to caddy/Caddyfile's
# internal CA. Used by the `acme` build target, which compiles in the caddy-dns plugin for
# your DNS host — this file only names the provider, it cannot supply the code.
#
# Env (from the caddy service in compose):
#   BASE_DOMAIN           the wildcard to issue, e.g. home.example.com
#   CADDY_DNS_PROVIDER    the plugin's Caddyfile directive name, e.g. cloudflare
#   CADDY_DNS_TOKEN       its credential
#
# A provider needing several fields (acme-dns: username/password/subdomain/server_url) does
# not fit a single token — replace the `dns` line below with its own block. That is a file
# edit by design: the shape varies per provider, and guessing it in an env var helps nobody.
#
# Nothing here is exposed to the internet: DNS-01 is an outbound API call, and the names
# still resolve on the LAN through AdGuard rewrites.
{
	# Internal to the Docker network — Loskai reaches this as caddy:2019. Not published.
	admin 0.0.0.0:2019
}

# One wildcard covers every name Loskai routes, so a pushed route needs no issuance of its
# own. The 404 answers names that resolve here but have no route — the block would otherwise
# be handler-less and reply with an empty 200, which reads as a broken service.
*.{$BASE_DOMAIN} {
	tls {
		dns {$CADDY_DNS_PROVIDER} {env.CADDY_DNS_TOKEN}
	}
	header Content-Type "text/html; charset=utf-8"
	respond <<HTML
		<!doctype html>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Not routed — {host}</title>
		<style>
			body { background:#0f172a; color:#e2e8f0; font:16px/1.6 system-ui, sans-serif;
			       display:grid; place-items:center; min-height:100vh; margin:0; padding:2rem }
			div { max-width:32rem; text-align:center }
			h1 { font-size:1.25rem; margin:0 0 .5rem }
			code { background:#1e293b; padding:.15rem .4rem; border-radius:.25rem }
			p { color:#94a3b8; margin:.5rem 0 0 }
		</style>
		<div>
			<h1>Nothing is routed at <code>{host}</code></h1>
			<p>The name resolves and this server answered, but no service is assigned to it.</p>
			<p>Add a route for it in Loskai, or check the name for a typo.</p>
		</div>
		HTML 404
}

# There is no onboarding page here — publicly trusted certs leave nothing to install. The
# server itself stays: it is where a `scheme: "http"`/`"both"` route is pushed (index 0,
# ahead of this catch-all), and where Caddy puts its HTTP->HTTPS redirects.
:80 {
	respond "Nothing is routed at this name." 404
}

# Caddyfile for every Caddy Loskai ships: the Caddy container built from caddy/Dockerfile
# (compose.caddy-loskai.yml, compose.colocated.yml) and the Caddy LXC, which fetches this
# file (scripts/create-caddy-lxc.sh). Admin endpoint, TLS setup and the two servers — no
# routes. Loskai pushes every specific-host route at runtime
# via the Admin API (in a container, reached as caddy.loskai.internal:2019 on the internal
# Docker network — never a bare `caddy`, which falls through to the LAN's DNS).
#
# TLS is Caddy's internal CA (local_certs) — no domain or ACME/DNS token needed. A device
# trusts its root from Loskai's Certificate page. Public ACME certs were removed
# deliberately — see caddy/Dockerfile.
{
	# Internal to the Docker network — Loskai reaches this as caddy.loskai.internal:2019. Not published.
	admin 0.0.0.0:2019
	local_certs # Caddy is its own CA — every certificate is internal
}

# Gives Caddy the :443 server Loskai adds every route to — Loskai finds that server by its
# listener and never creates one. It matches only `localhost`, never a name Loskai routes, so
# it can't shadow a route. Caddy needs no domain: each routed name gets its own internal cert
# as its route lands. A name nothing is routed at has no cert, so a browser stops at that.
localhost {
	respond "Loskai's Caddy — nothing is routed here." 404
}

# Gives Caddy the plain-HTTP server Loskai adds a route served over HTTP to, at index 0 —
# matched before anything here. Any other name is sent on to HTTPS; Caddy reached by its
# address, which has no certificate, gets the same answer as `localhost`.
:80 {
	@name not header_regexp Host ^(\d{1,3}(\.\d{1,3}){3}|\[[0-9A-Fa-f:.]+\])(:\d+)?$
	redir @name https://{host}{uri}
	respond "Loskai's Caddy — nothing is routed here." 404
}

# Loskai configuration — every value is optional; anything left unset can be configured
# in the UI on first run. Full reference (what each variable does, priority chain,
# volumes): docs/guides/deployment.md. Copy to `.env` and edit as needed.

# Host path for Docker compose stacks — drives a same-path bind mount, see docs/guides/deployment.md
STACKS_DIR=/opt/stacks

# Where Loskai keeps its own state: settings.json, instances.json, the session secret, and
# recipes/. Leave this UNSET for the compose stacks — the default /data is the in-container
# path and `./data:/data` already mounts it. Set it only when running the backend directly
# on your machine (make backend), where /data isn't writable:
#LOSKAI_DATA_DIR=/home/you/loskai-data

# This Docker host's LAN IP — auto-fills container-route upstreams as <host_ip>:<port>
# wherever Caddy can't reach a container by name. Same value as CADDY_HOST_IP when Caddy
# runs here (compose.caddy-loskai.yml / compose.colocated.yml).
#HOST_IP=192.168.10.x

# Your domain — service prefixes are appended (e.g. grafana -> grafana.example.no)
#BASE_DOMAIN=example.no

# Guards the admin UI — stored hashed, never plaintext
#LOSKAI_PASSWORD=changeme

# Caddy Admin API — a LAN IP (compose.yml, Caddy on its own LXC). The two layouts that run
# Caddy as a container here pin it to http://caddy:2019 in the compose file; leave it unset.
#CADDY_ADMIN_URL=http://192.168.10.101:2019

# IP DNS rewrites resolve to — required whenever Caddy runs here (CADDY_ADMIN_URL is then a
# hostname, so it can't be derived). Must be an address other machines can reach.
#CADDY_HOST_IP=192.168.10.101

# AdGuard Home REST API + Basic Auth credentials
#ADGUARD_URL=http://192.168.10.101:3000
#ADGUARD_USER=admin
#ADGUARD_PASSWORD=changeme

# WireGuard dashboard (wg-easy / wg-dashboard) — optional, no auth
#WIREGUARD_DASHBOARD_URL=http://192.168.10.102:51821

# Public git repo the install wizard syncs recipes from
#RECIPES_REPO_URL=https://github.com/you/loskai-recipes

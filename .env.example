# Loskai configuration — every value is optional.
# Anything set here takes priority over the UI settings page; anything left unset
# can be configured in-app on first run. Copy to `.env` and edit as needed.
#
# The ACME/DNS-challenge token (DuckDNS, Cloudflare, …) is NOT set here — it belongs
# to Caddy on LXC 101 (or the Caddy container in the co-located setup). Loskai never needs it.

# Host path for Docker compose stacks. Drives the same-path bind mount in compose.yml,
# so it lives here (compose/env only), never the UI. Must match the mount or stacks won't be found.
STACKS_DIR=/opt/stacks

# This Docker host's LAN IP. In split-LXC mode Caddy can't resolve container names, so a
# container route needs <host_ip>:<published-port>; set this once and Loskai auto-fills that
# upstream when you route a container (a bridged container can't detect its own host IP).
#HOST_IP=192.168.10.x

# Your domain — service prefixes are appended to this (e.g. grafana -> grafana.example.no)
#BASE_DOMAIN=example.no

# Guards the admin UI. Set here or create it at first run. Stored hashed, never plaintext.
#LOSKAI_PASSWORD=changeme

# Caddy Admin API. LAN IP = external/preferred mode; a hostname (http://caddy:2019) = Docker mode.
# The IP that DNS rewrites resolve names to (where Caddy listens on :443). Only needed when
# CADDY_ADMIN_URL is a hostname (Docker co-located mode); otherwise derived from its host.
#CADDY_ADMIN_URL=http://192.168.10.101:2019
#CADDY_HOST_IP=192.168.10.101

# AdGuard Home API + Basic Auth credentials.
#ADGUARD_URL=http://192.168.10.101:3000
#ADGUARD_USER=admin
#ADGUARD_PASSWORD=changeme

# WireGuard dashboard (wg-easy / wg-dashboard). Optional, no auth required.
#WIREGUARD_DASHBOARD_URL=http://192.168.10.102:51821

# Public git repo the install wizard syncs recipes from. Unset = wizard shows an empty state.
#RECIPES_REPO_URL=https://github.com/you/loskai-recipes



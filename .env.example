# Loskai configuration — every value is optional; anything left unset can be configured
# in the UI on first run. Full reference (what each variable does, priority chain,
# volumes): docs/guides/deployment.md. Copy to `.env` and edit as needed.

# Host path for Docker compose stacks — drives a same-path bind mount (the container sees
# the identical path, see docs/guides/deployment.md). Defaults to ./stacks beside the
# compose file, which is what you want if you run compose from the project directory.
# Set it to an absolute path to put stacks elsewhere, or to stop depending on where you
# invoke compose from (a systemd unit with no WorkingDirectory, say).
#STACKS_DIR=/srv/stacks

# Where Loskai keeps its own state: settings.json, instances.json, the session secret, and
# recipes/. Leave this UNSET either way: the compose files pass /data themselves to match
# their `./data:/data` mount, and running the backend directly defaults to the repo's own
# data/. Set it only to keep state somewhere else when running directly:
#LOSKAI_DATA_DIR=/home/you/loskai-data

# This Docker host's LAN IP — auto-fills container-route upstreams as <host_ip>:<port>
# wherever Caddy can't reach a container by name, and is the only address Loskai's SSH keys
# work from on your machines (`from=`). Same value as CADDY_HOST_IP when Caddy
# runs here (compose.caddy-loskai.yml / compose.colocated.yml).
#HOST_IP=192.168.10.x

# Your domain — service prefixes are appended (e.g. grafana -> grafana.example.no)
#BASE_DOMAIN=example.no

# The first admin account, made at startup while no account exists — its password stored
# hashed, never plaintext; the name is `admin` unless set. Unset, the first page asks for
# them instead. More accounts are added in Settings › Users.
#LOSKAI_PASSWORD=changeme
#LOSKAI_USERNAME=admin

# Each of these is also in Settings; set here, it wins there. Session: minutes a session
# lasts once no Loskai page is open (30, 60, 120, 480, 1440, 10080). SSH unlock: minutes your
# password unlocks Loskai's SSH key for (15, 60, 180, 480, 1440). Certificate tab: who sees
# the Certificate link (public, admin, hidden).
#SESSION_IDLE_MINUTES=120
#SSH_UNLOCK_MINUTES=15
#CERTIFICATE_TAB=public

# Caddy Admin API — a LAN IP (compose.yml, Caddy on its own LXC). The two layouts that run
# Caddy as a container here pin it to http://caddy:2019 in the compose file; leave it unset.
#CADDY_ADMIN_URL=http://192.168.10.101:2019

# IP DNS rewrites resolve to — required whenever Caddy runs here (CADDY_ADMIN_URL is then a
# hostname, so it can't be derived). Must be an address other machines can reach.
#CADDY_HOST_IP=192.168.10.101

# AdGuard Home REST API + Basic Auth credentials
#ADGUARD_URL=http://192.168.10.101:3000
#ADGUARD_USER=admin
#ADGUARD_PASSWORD=changeme

# WireGuard dashboard (wg-easy / wg-dashboard) — optional, no auth
#WIREGUARD_DASHBOARD_URL=http://192.168.10.102:51821

# Recipe sources have no variable: they are a list of rows in Settings > General, seeded
# with Loskai's built-in default, and nothing about them is needed before the UI is up.
